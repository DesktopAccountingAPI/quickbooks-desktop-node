{
  "name": "@desktopaccountingapi/quickbooks-desktop",
  "version": "0.1.0",
  "description": "Node.js and TypeScript SDK for Desktop Accounting API, the REST API for QuickBooks Desktop.",
  "license": "MIT",
  "author": "Desktop Accounting API",
  "homepage": "https://www.desktopaccountingapi.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesktopAccountingAPI/quickbooks-desktop-node.git"
  },
  "bugs": {
    "url": "https://github.com/DesktopAccountingAPI/quickbooks-desktop-node/issues"
  },
  "keywords": [
    "quickbooks",
    "quickbooks-desktop",
    "qbxml",
    "accounting",
    "api",
    "sdk",
    "desktop-accounting-api"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:conformance": "node --test test/conformance.test.ts",
    "test:dist": "node scripts/test-dist.mjs",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
